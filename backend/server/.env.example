# 서버 포트 (기존과 동일하게 3000 유지)
PORT=3000

# 프론트엔드 허용 origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# AI 서버(FastAPI) 주소
AI_SERVER_URL=http://localhost:8000

# 로그인 토큰 서명 키: 배포 환경에서는 충분히 긴 임의 문자열로 반드시 변경
AUTH_TOKEN_SECRET=change_this_to_a_long_random_secret_before_deploy
# 로그인 유지 기간(초): 기본 7일
AUTH_TOKEN_MAX_AGE_SECONDS=604800

# 시연 중에는 true로 설정합니다. 실제 스냅샷·위험 알림·이메일 발송을 막습니다.
DEMO_MODE=true
# 실제 자동 알림은 DEMO_MODE=false 이면서 이 값을 true로 설정한 경우에만 생성됩니다.
ENABLE_AUTOMATED_ALERTS=false
# 관심기업 뉴스 수집·로컬 감성분석 정기 작업은 명시적으로 true일 때만 등록됩니다.
ENABLE_WATCHLIST_SCHEDULER=false

# MySQL 접속 정보
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dtect
DB_USER=root
DB_PASSWORD=

# 네이버 뉴스 검색 API
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
