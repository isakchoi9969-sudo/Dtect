# 서버 포트 (기존과 동일하게 3000 유지)
PORT=3000

# 프론트엔드 허용 origin (CORS)
FRONTEND_ORIGIN=http://localhost:5173

# AI 서버(FastAPI) 주소
AI_SERVER_URL=http://localhost:6000

# 뉴스 수집·감성분석 결과 캐시 유지 시간(초). 0이면 비활성화
NEWS_CACHE_TTL_SECONDS=300

# 매일 수집할 기업명(쉼표로 구분)
NEWS_COLLECTION_COMPANIES=삼성전자,삼성물산,삼성바이오로직스,삼성SDI,삼성생명,카카오,현대자동차
NEWS_COLLECTION_PER_PAGE=100

# MySQL 접속 정보
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dtect
DB_USER=root
DB_PASSWORD=

# 네이버 뉴스 검색 API
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
