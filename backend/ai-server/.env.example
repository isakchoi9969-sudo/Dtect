# AI 서버 포트 (Node 서버 3000과 겹치지 않게 6000 사용)
PORT=6000

# Windows 통합 실행에서는 Uvicorn 리로드가 Node/Vite까지 종료할 수 있어 기본 비활성화
AI_RELOAD=false

# 이 서버를 호출할 수 있는 Node 서버 origin (CORS)
NODE_SERVER_ORIGIN=http://localhost:3000

# 감성분석 모델
SENTIMENT_MODEL_NAME=snunlp/KR-FinBERT-SC
SENTIMENT_BATCH_SIZE=8

# 과거 유사사례 시뮬레이터의 로컬 벡터 DB와 임베딩 모델
# 상대경로는 backend/ai-server 기준으로 해석된다.
SIMULATOR_CHROMA_PATH=data/news_vector_db
SIMULATOR_CHROMA_COLLECTION=crisis_simulation_bge
SIMULATOR_MODEL_NAME=BAAI/bge-m3
